# ==============================================================================
# VoxRead Security & Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO GIT. Copy this file to .env and configure.
# ==============================================================================

# Node.js Server Environment
NODE_ENV=development
PROXY_PORT=3001
HOST=127.0.0.1

# AI & External Services (SERVER ONLY - NEVER EXPOSE TO CLIENT)
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=http://127.0.0.1:3000

# Authentication & Session Security (SERVER ONLY)
# Generate a strong 32+ character random string: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters

# Data Encryption at Rest (SERVER ONLY)
# 32-byte hex string for AES-256-GCM: openssl rand -hex 32
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cloud Database & Supabase Configuration
# Client-side Public Key (RLS enforced - Safe for client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server-side Administrative Key (BYPASSES RLS - SERVER ONLY - NEVER BUNDLE TO CLIENT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anti-Bot Protection (Cloudflare Turnstile)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-public-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-private-secret-key

